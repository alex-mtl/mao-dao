# Port this sidecar's WebSocket signaling server listens on. Never
# exposed directly in production — nginx proxies a WSS upgrade to it over
# loopback, the same pattern already used for Reverb (see the "Mafia
# Extension" plan §2.1/Phase 6 and CLAUDE.md).
PORT=8381

# Must match Laravel's MEDIA_SFU_SHARED_SECRET exactly (same value, both
# sides) — used to (a) verify the short-lived join token Laravel issues
# to each player and (b) authenticate this service's own calls back to
# Laravel's internal can-view endpoint. Generate with
# `openssl rand -hex 32`; never commit a real value.
SHARED_SECRET=

# The quiz app's own base URL, used only for this sidecar's outbound
# calls to the internal can-view endpoint (plan Phase 7's server-side
# viewing-authorization design) — e.g. http://127.0.0.1:8000 in dev,
# https://mao-dao.com/quiz in production. Not the same as APP_MAFIA_URL;
# this is a server-to-server call, never seen by a browser.
LARAVEL_BASE_URL=http://127.0.0.1:8000

# mediasoup's WebRtcTransport announces this IP to peers as its public
# address — must be the server's real public IP in production (peers
# can't otherwise find their way back to it), and can stay 127.0.0.1 for
# same-machine local dev.
PUBLIC_IP=127.0.0.1

# UDP port range mediasoup's worker uses for actual media. On mao-dao's
# production box specifically: ttl10's own mediasoup worker already runs
# there in the 40000-49999 range (its ws.js default) and demonstrably
# works for real users without a TURN relay, which means that range is
# almost certainly already open in the security group — this default
# (45000-45100) deliberately sits inside that same window, clear of the
# ~40000s ttl10 actually allocates from, specifically so deploying this
# sidecar doesn't require opening anything new. Verify reachability
# empirically before assuming either way (same approach used to confirm
# Reverb's port), rather than opening a new range pre-emptively.
RTC_MIN_PORT=45000
RTC_MAX_PORT=45100
