APP_NAME="Quiz Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_PORT=8000

# Used by docker-compose.yml when building the app container so files
# written from inside the container are owned by your host user. Run
# `id -u` / `id -g` to find your own values; the defaults below are a
# common Linux default and usually fine to leave as-is on Windows/Mac.
WWWUSER=1000
WWWGROUP=1000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=sail
DB_PASSWORD=password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Race Mode's real-time transport. REVERB_HOST/PORT are also read by the
# frontend (via the VITE_ mirrors below) so the browser knows where to
# open the WebSocket connection — see resources/js/echo.js.
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Server-to-server publishing runs inside the laravel.test container,
# where "localhost" means itself, not the separate `reverb` container —
# see config/broadcasting.php. Set to the docker-compose service name.
REVERB_SERVER_HOST=reverb
REVERB_SERVER_PORT=8080
REVERB_SERVER_SCHEME=http
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"

# Mafia voice/video (Phase 7) — the media-sfu/ sidecar, a separate
# Node.js process this app never runs itself, only talks to. Must match
# media-sfu/.env's own SHARED_SECRET exactly. Generate with
# `openssl rand -hex 32`; never commit a real value. No VITE_ mirror
# needed — the browser learns the sidecar's ws:// URL from the
# media-token response itself (MafiaController::mediaToken()), not a
# baked-in build-time constant.
MEDIA_SFU_SHARED_SECRET=
MEDIA_SFU_WS_URL=ws://127.0.0.1:8381
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

TELEGRAM_BOT_NAME=
TELEGRAM_BOT_TOKEN=
TELEGRAM_REDIRECT_URI="${APP_URL}/auth/telegram/callback"

VITE_APP_NAME="${APP_NAME}"
VITE_TELEGRAM_BOT_NAME="${TELEGRAM_BOT_NAME}"
